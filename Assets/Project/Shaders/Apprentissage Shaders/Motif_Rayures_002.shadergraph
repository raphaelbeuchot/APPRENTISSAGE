{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "d080b0e99473261949e1a54642474564",
    "m_Title": "Position",
    "m_Content": "Position objet × échelle de l'objet : toutes les mesures (Épaisseur, Largeur, Hauteur, Position Y, Centre) sont en mètres.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -6300,
        "y": -1100,
        "width": 500,
        "height": 110
    },
    "m_Group": {
        "m_Id": "3fe7e63fc01c3ae7dd8435c40cf2661c"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "600aea9f94f81b0077bca96ac503918e",
    "m_Title": "Bosse",
    "m_Content": "u = Clamp((x − Centre) / (Largeur / 2), −1, 1)\nf = Hauteur × 0,5 × (1 + cos(π·u))\nLe Clamp met la bosse à 0 hors de sa largeur. Hauteur négative = creux.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -5400,
        "y": -2000,
        "width": 560,
        "height": 140
    },
    "m_Group": {
        "m_Id": "408d5e2678f0974a2d01be2c66c7231b"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "26d1dcdb8f5f6625e6484946aafd598d",
    "m_Title": "Pente",
    "m_Content": "f' = Hauteur × π × sin(π·u) / Largeur (signe sans importance : on l'élève au carré)\nnorme = √(1 + f'²)",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -4150,
        "y": -950,
        "width": 560,
        "height": 110
    },
    "m_Group": {
        "m_Id": "88342ad0983647e39837f967862cb5c4"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "9714fdf55ea34df529115e7d14abd437",
    "m_Title": "Distance",
    "m_Content": "d = (y − Position Y − f) / norme\nDiviser par la norme corrige la pente : épaisseur constante sur les flancs (approximation, exacte près de la bande de référence).",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -2650,
        "y": -1050,
        "width": 560,
        "height": 140
    },
    "m_Group": {
        "m_Id": "116dcf944c7f19de8e980d586b49744e"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "71d60d39fe6bb39edec20190a4b97397",
    "m_Title": "Index de bande",
    "m_Content": "k = Floor(d / Épaisseur + 0,5)\nk = 0 : bande de référence, centrée sur la courbe. 1, 2… au-dessus ; −1, −2… en dessous.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -1900,
        "y": -1050,
        "width": 560,
        "height": 120
    },
    "m_Group": {
        "m_Id": "1d39a0719e4be68e4ba101ead1847aeb"
    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "d515f694c8ea8dff25ceb489bf9c4ba3",
    "m_Title": "Zone",
    "m_Content": "Masque = 1 si −Bandes Dessous ≤ k ≤ Bandes Dessus, sinon 0.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -900,
        "y": -750,
        "width": 420,
        "height": 90
    },
    "m_Group": {
        "m_Id": "110d85b78be61448ca39e6e76412f514"
    }
}

